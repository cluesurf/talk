{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "host",
    "noErrorTruncation": true,
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["index.ts", "code", "test", "*.config.ts", "*.d.ts"],
  "exclude": ["node_modules", "host", "tmp"]
}
