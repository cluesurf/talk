{
  "version": "3.0.4",
  "name": "@cluesurf/talk",
  "description": "Tokenized IPA for AI and NLP, a keyboard-friendly ASCII phonetic encoding that converts to and from IPA with one token per effective sound.",
  "author": "Lance Pollard <lancejpollard@gmail.com>",
  "contributors": ["ClueSurf"],
  "keywords": [
    "nlp",
    "text-to-speech",
    "transliteration",
    "linguistics",
    "tts",
    "phonology",
    "ipa",
    "phonetics",
    "computational-linguistics",
    "romanization",
    "writing-systems",
    "international-phonetic-alphabet",
    "phonetic-alphabet",
    "phonetic-transcription"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./host/index.cjs",
  "module": "./host/index.js",
  "types": "./host/index.d.ts",
  "exports": {
    ".": {
      "types": "./host/index.d.ts",
      "import": "./host/index.js",
      "require": "./host/index.cjs"
    },
    "./syllable": {
      "types": "./host/syllable/index.d.ts",
      "import": "./host/syllable/index.js",
      "require": "./host/syllable/index.cjs"
    },
    "./token": {
      "types": "./host/token/index.d.ts",
      "import": "./host/token/index.js",
      "require": "./host/token/index.cjs"
    }
  },
  "sideEffects": false,
  "prettier": "@cluesurf/wash/flow.json",
  "scripts": {
    "copy:base": "tsx code/make/copy-base.ts",
    "build": "pnpm copy:base && tsup",
    "lint": "eslint . --fix && prettier --write .",
    "pretest": "pnpm copy:base",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:watch": "NODE_NO_WARNINGS=1 vitest",
    "host": "pnpm build && npm publish --access=public",
    "clusters": "NODE_NO_WARNINGS=1 tsx code/make/clusters.ts",
    "prepublishOnly": "pnpm build",
    "tokens": "NODE_NO_WARNINGS=1 tsx code/make/tokens.ts"
  },
  "devDependencies": {
    "@cluesurf/wash": "^0.10.10",
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "jiti": "^2.4.2",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
