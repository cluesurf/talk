{
  "version": "2.0.0",
  "name": "@cluesurf/talk",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./syllable": {
      "types": "./dist/syllable/index.d.ts",
      "import": "./dist/syllable/index.js",
      "require": "./dist/syllable/index.cjs"
    }
  },
  "sideEffects": false,
  "prettier": "@cluesurf/wash/flow.json",
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --fix && prettier --write .",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:watch": "NODE_NO_WARNINGS=1 vitest",
    "tokens": "NODE_NO_WARNINGS=1 tsx code/make/tokens.ts",
    "clusters": "NODE_NO_WARNINGS=1 tsx code/make/clusters.ts",
    "prepublishOnly": "pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["unrs-resolver"],
    "ignoredBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@cluesurf/wash": "^0.10.10",
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "jiti": "^2.4.2",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
