{
  "version": "1.7.8",
  "name": "@cluesurf/talk",
  "main": "./host/index.js",
  "module": "./host/index.mjs",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./host/index.d.ts",
      "import": "./host/index.mjs",
      "require": "./host/index.js"
    },
    "./*": {
      "types": "./host/code/*.d.ts",
      "import": "./host/code/*.mjs",
      "require": "./host/code/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": ["host/code/*.d.ts"],
      ".": ["host/index.d.ts"]
    }
  },
  "files": ["host"],
  "prettier": "@cluesurf/wash/flow.json",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@lancejpollard/script-tree": "^1.1.4",
    "lodash": "4.17.23",
    "x-sampa-ipa": "^0.0.3"
  },
  "scripts": {
    "make": "rm -rf host && tsup --no-dts && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "scan": "concurrently --kill-others \"tsc -p tsconfig.build.json -w\" \"tsc-alias -p tsconfig.build.json -w\"",
    "lint": "eslint . --fix && prettier --write .",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "test:watch": "NODE_NO_WARNINGS=1 vitest",
    "mappings": "NODE_NO_WARNINGS=1 npx tsx code/make/build-mappings.ts",
    "cluster": "NODE_NO_WARNINGS=1 npx tsx code/make/cluster-builder.ts",
    "glyphs": "NODE_NO_WARNINGS=1 npx tsx code/make/glyph-builder.ts",
    "host": "pnpm make && npm publish --access=public"
  },
  "devDependencies": {
    "@cluesurf/wash": "^0.10.10",
    "@types/lodash": "4.17.23",
    "@types/node": "^22.15.3",
    "concurrently": "^7.6.0",
    "eslint": "^9.26.0",
    "jiti": "^2.4.2",
    "prettier": "^3.6.2",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "tsup": "^8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
